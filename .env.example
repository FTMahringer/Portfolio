# =========================================
# Portfolio local environment example
# =========================================
# Copy this file to .env.local and adjust values:
#   cp .env.local.example .env.local
#
# After setting ADMIN_EMAIL and ADMIN_PASSWORD, seed the admin user once:
#   npm run db:push
#   npm run db:seed

# --- Required ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_please
API_SECRET=change_me_api_secret

# --- Optional: OIDC / SSO fallback provider ---
# Leave empty if you configure providers in the admin UI instead.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Use your public callback URL. For local dev, keep it on your actual app origin.
# Example default dev URL:
# OIDC_REDIRECT_URI=http://localhost:3000/api/admin/auth/callback
# If you run on port 3005, use:
# OIDC_REDIRECT_URI=http://localhost:3005/api/admin/auth/callback
OIDC_REDIRECT_URI=
# Optional: restrict SSO login to one email address.
OIDC_ALLOWED_EMAIL=

# --- Optional: Contact form email via Resend ---
RESEND_API_KEY=

# --- Optional: Admin network bypass (comma-separated CIDRs) ---
# Example: INTERNAL_CIDRS=10.0.0.0/8,192.168.0.0/16
INTERNAL_CIDRS=

# --- Optional: Docker init script override (usually not needed locally) ---
# DB_PATH=./data/portfolio.db
